# SafeRoute Backend Configuration
PORT=3001
FRONTEND_URL=http://localhost:5174

# Real Gmail / SMTP Emergency Email Delivery Setup
# 1. Enable 2-Step Verification on your Gmail account (myaccount.google.com/security)
# 2. Generate an App Password under Security -> App Passwords
# 3. Enter your Gmail address and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
FROM_EMAIL=yourgmail@gmail.com

# Web Push VAPID Keys — generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@saferoute.app
